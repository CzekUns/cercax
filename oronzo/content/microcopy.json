        "spogliatoio"
      ],
      "when": {}
    },
    {
      "id": "mc_spogliatoio_07",
      "channel": "notice",
      "category": "spogliatoio",
      "text": "Il discorso del mister è durato poco. L'acqua calda non ha aspettato.",
