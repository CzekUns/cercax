      "cooldownWeeks": 2,
      "tags": [
        "tifoseria"
      ],
      "when": {}
    },
    {
      "id": "mc_tifoseria_07",
      "channel": "ticker",
      "category": "tifoseria",
      "text": "Nella ha chiesto meno parole e più rincorse.",
