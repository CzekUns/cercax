      "cooldownWeeks": 2,
      "tags": [
        "tifoseria"
      ],
      "when": {}
    },
    {
      "id": "mc_caricamento_01",
      "channel": "ticker",
      "category": "caricamento",
      "text": "Si cercano due palloni ancora gonfi.",
