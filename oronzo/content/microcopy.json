      "cooldownWeeks": 2,
      "tags": [
        "spogliatoio"
      ],
      "when": {}
    },
    {
      "id": "mc_tifoseria_01",
      "channel": "ticker",
      "category": "tifoseria",
      "text": "La curva vende sciarpe. Il resto si paga alla fine.",
